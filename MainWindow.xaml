<Window x:Class="ValeriosPizza.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ValeriosPizza"
        xmlns:views="clr-namespace:ValeriosPizza.Views"
        xmlns:vm="clr-namespace:ValeriosPizza.ViewModels"
        xmlns:svc="clr-namespace:ValeriosPizza.Services"
        mc:Ignorable="d"
        Title="{Binding Titulo}" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.ico"
        PreviewMouseWheel="MainWindow_PreviewMouseWheel"
        Closing="MainWindow_Closing"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    
    <Window.InputBindings>
        <!-- Atajos globales para Deshacer / Rehacer. Si el foco est\u00e1 en un
             TextBox, WPF deja que el TextBox maneje primero su propio Ctrl+Z
             interno gracias a la naturaleza enrutada del input; los atajos
             aqu\u00ed s\u00f3lo disparan cuando ning\u00fan control con foco los consume. -->
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding DeshacerCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RehacerCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- DataTemplates para cada View -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistroRapidoViewModel}">
            <views:RegistroRapidoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MercanciaNuevaViewModel}">
            <views:MercanciaNuevaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventarioViewModel}">
            <views:InventarioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsultaViewModel}">
            <views:ConsultaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportesViewModel}">
            <views:ReportesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BodegaViewModel}">
            <views:BodegaView/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel de Navegación Lateral -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource SidebarBackgroundBrush}" MinHeight="750">
                <DockPanel>
                    <!-- Logo y Nombre -->
                    <Border DockPanel.Dock="Top" Padding="30,30,30,40">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Logo circular: el marco se mantiene oscuro en todos
                                 los temas para que el rojo del logo nunca compita
                                 con un fondo claro y se preserve la nitidez. -->
                            <Border Width="180" Height="180" CornerRadius="90"
                                    BorderBrush="#3A3A3A" BorderThickness="3"
                                    Margin="0,0,0,20" Background="#2A2A2A"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <Border CornerRadius="90" ClipToBounds="True">
                                    <Border.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Ellipse Width="180" Height="180" Fill="White"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.OpacityMask>
                                    <Image Source="/Assets/logo.png"
                                           Stretch="UniformToFill"
                                           SnapsToDevicePixels="True"
                                           UseLayoutRounding="True"
                                           RenderOptions.BitmapScalingMode="Fant"
                                           RenderOptions.EdgeMode="Unspecified"/>
                                </Border>
                            </Border>
                            <TextBlock Text="VALERIO'S" 
                                       FontSize="24" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextOnDarkBrush}" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Sistema de Inventario" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource SidebarSubtitleBrush}" 
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Menú de Navegación -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                        <Button Content="Dashboard" 
                                Command="{Binding NavDashboardCommand}"
                                Tag="{Binding DashboardVM}"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,2"/>
                        
                        <Button Content="Registro Rápido" 
                                Command="{Binding NavRegistroCommand}"
                                Tag="{Binding RegistroRapidoVM}"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,2"/>
                        
                        <Button Content="Mercancía Nueva" 
                                Command="{Binding NavMercanciaCommand}"
                                Tag="{Binding MercanciaNuevaVM}"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,2"/>
                        
                        <Button Content="Inventario" 
                                Command="{Binding NavInventarioCommand}"
                                Tag="{Binding InventarioVM}"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,2"/>
                        
                        <Button Content="Consulta" 
                                Command="{Binding NavConsultaCommand}"
                                Tag="{Binding ConsultaVM}"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,2"/>
                        
                        <Button Content="Reportes" 
                                Command="{Binding NavReportesCommand}"
                                Tag="{Binding ReportesVM}"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,2"/>

                        <!-- Bodega: almacén general aparte del inventario activo.
                             Va justo arriba de "Salir" por petición del dueño. -->
                        <Button Content="Bodega"
                                Command="{Binding NavBodegaCommand}"
                                Tag="{Binding BodegaVM}"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,2"/>

                        <!-- Salida de la aplicación. No es una sección navegable, así
                             que no se le asigna Tag (nunca queda resaltado). El
                             comando reenvía a un hook expuesto por MainWindow,
                             que dispara Window.Close() y deja que el evento
                             Closing pregunte por datos sin guardar. -->
                        <Button Content="Salir"
                                Command="{Binding SalirCommand}"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="0,2"/>
                    </StackPanel>

                    <!-- Footer con selector de tema -->
                    <Border DockPanel.Dock="Bottom" Padding="20,16" BorderBrush="{DynamicResource SidebarLogoFrameBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="TEMA" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource SidebarMutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Claro" Command="{Binding CambiarTemaCommand}"
                                        CommandParameter="{x:Static svc:AppTheme.Light}" ToolTip="Tema claro"
                                        Padding="6,3" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource SidebarMutedTextBrush}"/>
                                <Button Content="Oscuro" Command="{Binding CambiarTemaCommand}"
                                        CommandParameter="{x:Static svc:AppTheme.Dark}" ToolTip="Tema oscuro"
                                        Padding="6,3" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource SidebarMutedTextBrush}"/>
                                <Button Content="Sistema" Command="{Binding CambiarTemaCommand}"
                                        CommandParameter="{x:Static svc:AppTheme.Metallic}" ToolTip="Tema metálico"
                                        Padding="6,3" FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource SidebarMutedTextBrush}"/>
                                <Button Content="Drácula" Command="{Binding CambiarTemaCommand}"
                                        CommandParameter="{x:Static svc:AppTheme.RojoDracula}" ToolTip="Tema Rojo Drácula"
                                        Padding="6,3" FontSize="11" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource SidebarMutedTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="© 2026 Valerio's" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource SidebarMutedTextBrush}" 
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>
        </ScrollViewer>

        <!-- Área de Contenido Principal -->
        <DockPanel Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="{DynamicResource WindowBackgroundBrush}" MinHeight="710"
                        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                    <ContentControl Content="{Binding CurrentView}" Margin="0"/>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
