<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema OSCURO – inspirado en Windows 11 / Fluent Design.
         Superficies oscuras "Mica", acento azul claro y bordes muy sutiles. -->

    <!-- Superficies -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="#202020"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="SidebarLogoFrameBrush"  Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SidebarLogoBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"      Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SidebarPressedBrush"    Color="#383838"/>
    <SolidColorBrush x:Key="SidebarMutedTextBrush"  Color="#C8C8C8"/>
    <SolidColorBrush x:Key="SidebarSubtitleBrush"   Color="#9A9A9A"/>

    <SolidColorBrush x:Key="CardBackgroundBrush"   Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBorderBrush"       Color="#3A3A3A"/>
    <SolidColorBrush x:Key="CardAlternateRowBrush" Color="#262626"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#9A9A9A"/>
    <SolidColorBrush x:Key="TextSubtleBrush"    Color="#7A7A7A"/>
    <SolidColorBrush x:Key="TextOnDarkBrush"    Color="#FFFFFF"/>

    <!-- Acento Windows 11 oscuro (azul claro Fluent) -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#4CC2FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#62CCFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3AAEEB"/>
    <SolidColorBrush x:Key="AccentTextBrush"    Color="#000000"/>
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="#1F3A4D"/>

    <!-- Divisores e inputs -->
    <SolidColorBrush x:Key="DividerBrush"         Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2D2D2D"/>

    <!-- Resaltado de "Hoy" en la vista semanal de inventario. -->
    <SolidColorBrush x:Key="TodayHighlightBrush"      Color="#1F3A4D"/>
    <SolidColorBrush x:Key="OtherDayBackgroundBrush"  Color="#262626"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="DataGridHeaderUnderlineBrush"  Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DataGridCellForegroundBrush"   Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DataGridSelectedBrush"         Color="#1F3A4D"/>
    <SolidColorBrush x:Key="DataGridSelectedForegroundBrush" Color="#FFFFFF"/>

</ResourceDictionary>
