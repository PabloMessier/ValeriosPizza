<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema CLARO – inspirado en Windows 11 / Fluent Design.
         Superficies suaves tipo "Mica", acento azul de Windows y
         bordes muy sutiles. -->

    <!-- Superficies -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="#F3F3F3"/>
    <!-- Sidebar oscuro estilo Win11 (acrylic dark) sobre tema claro. -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="SidebarLogoFrameBrush"  Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SidebarLogoBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"      Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SidebarPressedBrush"    Color="#383838"/>
    <SolidColorBrush x:Key="SidebarMutedTextBrush"  Color="#C8C8C8"/>
    <SolidColorBrush x:Key="SidebarSubtitleBrush"   Color="#9A9A9A"/>

    <SolidColorBrush x:Key="CardBackgroundBrush"   Color="#FBFBFB"/>
    <SolidColorBrush x:Key="CardBorderBrush"       Color="#E5E5E5"/>
    <SolidColorBrush x:Key="CardAlternateRowBrush" Color="#F5F5F5"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TextSubtleBrush"    Color="#A0A0A0"/>
    <!-- Texto sobre el sidebar oscuro: blanco. -->
    <SolidColorBrush x:Key="TextOnDarkBrush"    Color="#FFFFFF"/>

    <!-- Acento Windows 11 (azul sistema) -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#1A75C7"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0058A8"/>
    <SolidColorBrush x:Key="AccentTextBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="#E5F0FA"/>

    <!-- Divisores e inputs -->
    <SolidColorBrush x:Key="DividerBrush"         Color="#E5E5E5"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>

    <!-- Resaltado de "Hoy" en la vista semanal de inventario. -->
    <SolidColorBrush x:Key="TodayHighlightBrush"      Color="#E5F0FA"/>
    <SolidColorBrush x:Key="OtherDayBackgroundBrush"  Color="#F5F5F5"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="DataGridHeaderUnderlineBrush"  Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DataGridCellForegroundBrush"   Color="#1B1B1B"/>
    <SolidColorBrush x:Key="DataGridSelectedBrush"         Color="#E5F0FA"/>
    <SolidColorBrush x:Key="DataGridSelectedForegroundBrush" Color="#1B1B1B"/>

</ResourceDictionary>
