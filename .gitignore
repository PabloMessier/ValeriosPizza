# =========================================================
# Valerio's Pizzeria — .gitignore (.NET 8 / WPF / SQLite)
# =========================================================

# ---- Build outputs ----
bin/
obj/
out/
publish/
artifacts/

# ---- Per-developer Visual Studio / IDE state ----
.vs/
.vscode/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
*.psess
*.vsp
*.vspx
*.sap

# JetBrains
.idea/
*.iml

# ---- Rider/ReSharper ----
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ---- Test results ----
TestResults/
*.trx
*.coverage
*.coveragexml
[Cc]overage*/

# ---- NuGet ----
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
project.assets.json
*.nuget.props
*.nuget.targets

# ---- Logs and error dumps produced by the app ----
error_dump.txt
*.log
logs/

# ---- Local SQLite DB and auto-backups (also live under %LOCALAPPDATA% but ignore here too) ----
*.db
*.db-shm
*.db-wal
*.valdb
*.sqlite
*.sqlite3
AutoBackups/

# ---- WPF / MSBuild temp ----
*.tmp_proj
*_wpftmp.csproj
*.tmp
*.temp
*.tlog
*.cache
*.ilk
*.iobj
*.ipdb
*.lastcodeanalysissucceeded
*.cachefile
*.VC.db
*.VC.VC.opendb

# ---- ClickOnce / publish profiles (keep the .pubxml itself in source, ignore secrets) ----
*.pubxml.user
PublishScripts/

# ---- Generic OS junk ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---- Backup files ----
*.bak
*.orig
*.rej
*~
