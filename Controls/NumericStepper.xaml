<UserControl x:Class="ValeriosPizza.Controls.NumericStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="38" d:DesignWidth="160"
             Focusable="False">
    <UserControl.Resources>
        <!-- Botón compacto reutilizable para los lados − y +. Usa el color de
             fondo del UserControl (configurable vía la propiedad ButtonBackground)
             para encajar con la tarjeta padre. -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#77FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Botón − (decrementar). PreviewMouseLeftButtonDown/Up controlan la
             repetición rápida al mantener presionado; el primer Down ya
             aplica un step inmediato, así que no engancho el evento Click. -->
        <Button Grid.Column="0"
                x:Name="DecrementButton"
                Content="−"
                Style="{StaticResource StepperButtonStyle}"
                PreviewMouseLeftButtonDown="DecrementButton_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="StepperButton_PreviewMouseLeftButtonUp"
                MouseLeave="StepperButton_MouseLeave"
                LostMouseCapture="StepperButton_LostMouseCapture"
                Margin="0,0,4,0"/>

        <!-- Campo de texto para escribir un valor directamente. Acepta sólo
             dígitos (y un signo - opcional si Minimum < 0). El commit del
             texto al binding ocurre en LostFocus o cuando la usuaria
             presiona Enter (manejado en code-behind). -->
        <TextBox Grid.Column="1"
                 x:Name="ValueTextBox"
                 Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=0}"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Padding="6,3"
                 BorderBrush="#44FFFFFF"
                 BorderThickness="1"
                 Background="#22FFFFFF"
                 Foreground="White"
                 CaretBrush="White"
                 SelectionBrush="#66FFFFFF"
                 PreviewTextInput="ValueTextBox_PreviewTextInput"
                 PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                 GotFocus="ValueTextBox_GotFocus"
                 MouseWheel="ValueTextBox_MouseWheel"/>

        <!-- Botón + (incrementar). Misma mecánica que el de menos. -->
        <Button Grid.Column="2"
                x:Name="IncrementButton"
                Content="+"
                Style="{StaticResource StepperButtonStyle}"
                PreviewMouseLeftButtonDown="IncrementButton_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="StepperButton_PreviewMouseLeftButtonUp"
                MouseLeave="StepperButton_MouseLeave"
                LostMouseCapture="StepperButton_LostMouseCapture"
                Margin="4,0,0,0"/>
    </Grid>
</UserControl>
