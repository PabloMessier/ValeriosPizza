<UserControl x:Class="ValeriosPizza.Views.RegistroRapido.ConteoAperturaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:ValeriosPizza.Views.Common"
             mc:Ignorable="d"
             d:DesignHeight="380" d:DesignWidth="1000">
    <Border Style="{StaticResource CardStyle}" Padding="15" BorderBrush="#1976D2" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="INVENTARIO APERTURA" FontSize="13" Foreground="#1976D2" FontWeight="Bold"/>
                    <TextBlock Text="Conteo físico antes de iniciar el servicio" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ NUEVO INGREDIENTE" Command="{Binding AgregarIngredienteAperturaCommand}"
                        Padding="14,8" FontSize="11" Margin="0,0,8,0" BorderBrush="#1976D2" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundBrush}" Foreground="#1976D2" Cursor="Hand" FontWeight="Medium"/>
                <Button Grid.Column="2" Content="GUARDAR APERTURA" Command="{Binding GuardarConteoAperturaCommand}"
                        Background="#1976D2" Foreground="White" Padding="18,8" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding LineasAperturaPaged.Items}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      BorderThickness="0" Background="Transparent"
                      RowBackground="{DynamicResource CardBackgroundBrush}" AlternatingRowBackground="{DynamicResource CardAlternateRowBrush}"
                      GridLinesVisibility="None" HeadersVisibility="Column"
                      FontSize="13" RowHeight="34" MaxHeight="260">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="INGREDIENTE" Binding="{Binding Nombre}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="UNIDAD" Binding="{Binding UnidadMedida}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remover"
                                        ToolTip="Eliminar definitivamente (solo si no tiene historial)"
                                        Command="{Binding DataContext.RemoverIngredienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,2" FontSize="11" Cursor="Hand"
                                        BorderThickness="0" Background="#C62828" Foreground="White"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <common:PaginatorBar Grid.Row="2" DataContext="{Binding LineasAperturaPaged}"/>
            <TextBlock Grid.Row="3" Text="Notas (opcional)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,2"/>
            <TextBox Grid.Row="4" Text="{Binding NotasApertura, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12" Height="40" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
