<UserControl x:Class="ValeriosPizza.Views.RegistroRapido.EntradaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="1000">
    <Border Style="{StaticResource CardStyle}" Padding="15" BorderBrush="#4CAF50" BorderThickness="2">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="0" Text="ENTRADA DE INGREDIENTES" FontSize="13" Foreground="#4CAF50" FontWeight="Bold" Margin="0,0,0,12"/>
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,0">
                    <TextBlock Text="Ingrediente" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding Ingredientes}" SelectedItem="{Binding IngredienteSeleccionado}" DisplayMemberPath="Nombre" Padding="10,8" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,8,0">
                    <TextBlock Text="Cantidad" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="8,0,8,0">
                    <TextBlock Text="Costo Total" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Costo, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="1" Margin="8,0,8,0">
                    <TextBlock Text="Proveedor / Notas" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Proveedor, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13"/>
                </StackPanel>
                <Button Grid.Column="4" Grid.Row="1" Content="GUARDAR ENTRADA" Command="{Binding GuardarEntradaCommand}"
                        Background="#4CAF50" Foreground="White" Padding="18,12" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom"/>
            </Grid>

            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0"
                    DataContext="{Binding CalcEntrada}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="PRECIO UNIT. (COP)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold"/>
                        <TextBox Text="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" FontSize="13" Padding="6,4" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="IMPUESTO (COP)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold"/>
                        <TextBox Text="{Binding Impuesto, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" FontSize="13" Padding="6,4" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                        <TextBlock Text="RETENCIÓN (COP)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold"/>
                        <TextBox Text="{Binding Retencion, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" FontSize="13" Padding="6,4" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="8,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Subtotal, StringFormat=Subtotal: ${0:N0} COP}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Total, StringFormat=TOTAL: ${0:N0} COP}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="Limpiar" Command="{Binding LimpiarCommand}" FontSize="11" Padding="10,6" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
