<UserControl x:Class="ValeriosPizza.Views.RegistroRapido.DiscosCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="1000">
    <Border Style="{StaticResource CardStyle}" Padding="15" Background="{DynamicResource AccentBrush}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="DISCOS INICIALES" FontSize="11" Foreground="#888" FontWeight="Medium"/>
                    <TextBox Text="{Binding DiscosIniciales, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                    <TextBlock Text="PREPARADOS" FontSize="11" Foreground="#888" FontWeight="Medium"/>
                    <TextBox Text="{Binding DiscosPreparados, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0,8,0">
                    <TextBlock Text="UTILIZADOS" FontSize="11" Foreground="#888" FontWeight="Medium"/>
                    <TextBox Text="{Binding DiscosUtilizados, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="8,0,8,0">
                    <TextBlock Text="MERMA" FontSize="11" Foreground="#888" FontWeight="Medium"/>
                    <TextBox Text="{Binding DiscosMerma, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="8,0,8,0">
                    <TextBlock Text="CORTESÍA" FontSize="11" Foreground="#888" FontWeight="Medium"/>
                    <TextBox Text="{Binding DiscosCortesia, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="15,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="DISPONIBLES" FontSize="11" Foreground="#888" FontWeight="Medium"/>
                    <TextBlock Text="{Binding DiscosDisponibles}" FontSize="32" Foreground="White" FontWeight="Light"/>
                </StackPanel>
                <Button Grid.Column="6" Content="GUARDAR DISCOS" Command="{Binding GuardarDiscosCommand}"
                        Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="18,12" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
