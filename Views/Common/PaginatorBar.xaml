<UserControl x:Class="ValeriosPizza.Views.Common.PaginatorBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="36" d:DesignWidth="640">
    <!-- DataContext esperado: una instancia de PagedCollectionView<T>.
         Se compone con cualquier DataGrid/ListView para añadirle paginación. -->
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="6,6,6,2">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Por página:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding OpcionesTamanoPagina}"
                          DisplayMemberPath="Etiqueta"
                          SelectedValuePath="Valor"
                          SelectedValue="{Binding TamanoPagina, Mode=TwoWay}"
                          FontSize="11" Padding="6,2" MinWidth="70" Margin="0,0,12,0"/>

                <Button Command="{Binding PrimeraCommand}"   Content="«" ToolTip="Primera página"
                        Padding="8,2" FontSize="13" Cursor="Hand" Margin="0,0,2,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Command="{Binding AnteriorCommand}"  Content="‹" ToolTip="Página anterior"
                        Padding="8,2" FontSize="13" Cursor="Hand" Margin="0,0,8,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="Página "/>
                    <Run Text="{Binding PaginaActual, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=" de "/>
                    <Run Text="{Binding TotalPaginas, Mode=OneWay}"/>
                </TextBlock>
                <Button Command="{Binding SiguienteCommand}" Content="›" ToolTip="Página siguiente"
                        Padding="8,2" FontSize="13" Cursor="Hand" Margin="8,0,2,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Command="{Binding UltimaCommand}"    Content="»" ToolTip="Última página"
                        Padding="8,2" FontSize="13" Cursor="Hand"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Text="{Binding Resumen}" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="2,0,12,0"/>
        </DockPanel>
    </Border>
</UserControl>
