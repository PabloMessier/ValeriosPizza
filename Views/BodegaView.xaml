<UserControl x:Class="ValeriosPizza.Views.BodegaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:ValeriosPizza.Views.Common"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Bodega" FontSize="26" FontWeight="Light"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Almacén general: items que el dueño separa del inventario activo"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Barra de filtros / acciones -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Buscar:" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="260" FontSize="13" Padding="8,6"
                                 Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filtrar por nombre o categoría"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#EFEBE9" Padding="12,8" CornerRadius="4"
                            Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total en bodega:" FontSize="12" Foreground="#6D4C41" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Total}" FontSize="14" Foreground="#6D4C41" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↻ REFRESCAR" Command="{Binding RefrescarCommand}"
                                Padding="14,8" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"/>
                        <Button Content="🗑 VACIAR BODEGA" Command="{Binding VaciarBodegaCommand}"
                                Padding="14,8" FontSize="12" Cursor="Hand" FontWeight="Medium"
                                Background="#C62828" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tabla -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ITEMS EN BODEGA" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"
                               Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ItemsPaged.Items}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="{DynamicResource CardBackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource CardAlternateRowBrush}"
                              GridLinesVisibility="None" HeadersVisibility="Column"
                              CanUserResizeRows="False"
                              FontSize="13" RowHeight="38" MinHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA"
                                                Binding="{Binding FechaAgregado, StringFormat=dd/MM/yyyy HH:mm}"
                                                SortMemberPath="FechaAgregado" Width="150"/>
                            <DataGridTextColumn Header="CATEGORÍA"
                                                Binding="{Binding Categoria}"
                                                SortMemberPath="Categoria" Width="120"/>
                            <DataGridTextColumn Header="NOMBRE"
                                                Binding="{Binding Nombre}"
                                                SortMemberPath="Nombre" Width="*"/>
                            <DataGridTextColumn Header="CANTIDAD"
                                                Binding="{Binding Cantidad, StringFormat=N2}"
                                                SortMemberPath="Cantidad" Width="100"/>
                            <DataGridTextColumn Header="UNIDAD"
                                                Binding="{Binding UnidadMedida}"
                                                SortMemberPath="UnidadMedida" Width="80"/>
                            <DataGridTextColumn Header="ORIGEN"
                                                Binding="{Binding Origen}"
                                                SortMemberPath="Origen" Width="140"/>
                            <DataGridTextColumn Header="NOTAS"
                                                Binding="{Binding Notas}"
                                                SortMemberPath="Notas" Width="220"/>
                            <DataGridTemplateColumn Header="ACCIONES" Width="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Quitar"
                                                Command="{Binding DataContext.RemoverItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4" FontSize="11" Cursor="Hand"
                                                BorderThickness="0" Background="#C62828" Foreground="White"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <common:PaginatorBar Grid.Row="2" DataContext="{Binding ItemsPaged}"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
