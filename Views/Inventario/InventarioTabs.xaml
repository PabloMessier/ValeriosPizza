<UserControl x:Class="ValeriosPizza.Views.Inventario.InventarioTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:ValeriosPizza.Models"
             xmlns:common="clr-namespace:ValeriosPizza.Views.Common"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <TabControl BorderThickness="0" Background="Transparent">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="15,8" Margin="0,0,4,0" Cursor="Hand">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </TabControl.Resources>

        <TabItem Header="INGREDIENTES">
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ AGREGAR INGREDIENTE" Command="{Binding AgregarIngredienteCommand}"
                                Padding="16,8" FontSize="12" FontWeight="Medium" Cursor="Hand"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0"/>
                        <TextBlock Text="Buscar:" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Width="200" FontSize="12" Padding="6,4" VerticalAlignment="Center"
                                 Text="{Binding FiltroIngredientes, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filtrar ingredientes por nombre"/>
                        <TextBlock Text="Use los botones de cada fila para editar, desactivar o remover ingredientes." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding IngredientesPaged.Items}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="{DynamicResource CardBackgroundBrush}" AlternatingRowBackground="{DynamicResource CardAlternateRowBrush}"
                              GridLinesVisibility="None" HeadersVisibility="Column"
                              CanUserResizeRows="False" FontSize="14" RowHeight="38">
                        <DataGrid.Columns>
                            <!-- CANTIDAD y MÍNIMO usan MultiBinding al converter de unidades,
                                 por eso necesitan SortMemberPath explícito a la propiedad
                                 numérica subyacente. De lo contrario el header no responde. -->
                            <DataGridTextColumn Header="NOMBRE"
                                                Binding="{Binding Nombre}"
                                                SortMemberPath="Nombre" Width="*"/>
                            <DataGridTextColumn Header="CANTIDAD" Width="100"
                                                SortMemberPath="CantidadActual">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding Converter="{StaticResource CantidadPorUnidadConverter}">
                                        <Binding Path="CantidadActual"/>
                                        <Binding Path="UnidadMedida"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="UNIDAD"
                                                Binding="{Binding UnidadMedida}"
                                                SortMemberPath="UnidadMedida" Width="80"/>
                            <DataGridTextColumn Header="MÍNIMO" Width="80"
                                                SortMemberPath="CantidadMinima">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding Converter="{StaticResource CantidadPorUnidadConverter}">
                                        <Binding Path="CantidadMinima"/>
                                        <Binding Path="UnidadMedida"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <!-- ACCIONES no se ordena: son botones de fila. -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="360" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Editar"
                                                    Command="{Binding DataContext.EditarIngredienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,4" FontSize="11" Margin="0,0,4,0" Cursor="Hand"
                                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource CardBackgroundBrush}"/>
                                            <Button Content="→ Bodega"
                                                    ToolTip="Agregar este ingrediente a la pantalla Bodega"
                                                    Command="{Binding DataContext.AgregarABodegaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,4" FontSize="11" Margin="0,0,4,0" Cursor="Hand"
                                                    BorderThickness="0" Background="#6D4C41" Foreground="White"/>
                                            <Button Content="Desactivar"
                                                    Command="{Binding DataContext.DesactivarIngredienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,4" FontSize="11" Margin="0,0,4,0" Cursor="Hand"
                                                    BorderBrush="#FFCDD2" BorderThickness="1" Background="{DynamicResource CardBackgroundBrush}" Foreground="#C62828"/>
                                            <Button Content="Remover"
                                                    ToolTip="Eliminar definitivamente (solo si no tiene historial)"
                                                    Command="{Binding DataContext.RemoverIngredienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,4" FontSize="11" Cursor="Hand"
                                                    BorderThickness="0" Background="#C62828" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <common:PaginatorBar Grid.Row="2" DataContext="{Binding IngredientesPaged}"/>
                </Grid>
            </Border>
        </TabItem>

        <TabItem Header="PRODUCTOS">
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ AGREGAR PRODUCTO" Command="{Binding AgregarProductoCommand}"
                                Padding="16,8" FontSize="12" FontWeight="Medium" Cursor="Hand"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0"/>
                        <TextBlock Text="Buscar:" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Width="200" FontSize="12" Padding="6,4" VerticalAlignment="Center"
                                 Text="{Binding FiltroProductos, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filtrar productos por nombre"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProductosPaged.Items}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          BorderThickness="0" Background="Transparent"
                          RowBackground="{DynamicResource CardBackgroundBrush}" AlternatingRowBackground="{DynamicResource CardAlternateRowBrush}"
                          GridLinesVisibility="None" HeadersVisibility="Column"
                          CanUserResizeRows="False" FontSize="14" RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOMBRE"
                                            Binding="{Binding Nombre}"
                                            SortMemberPath="Nombre" Width="*"/>
                        <DataGridTextColumn Header="CATEGORÍA"
                                            Binding="{Binding Categoria}"
                                            SortMemberPath="Categoria" Width="120"/>
                        <DataGridTemplateColumn Header="ESTADO" Width="140" SortMemberPath="Estado">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,0">
                                        <TextBlock Text="{Binding EstadoTexto}"
                                                   Foreground="{Binding ColorEstado}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="CAMBIAR ESTADO" Width="300" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Margin="4,0">
                                        <Button Content="Activo"
                                                Command="{Binding DataContext.MarcarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Width="82" Height="26" FontSize="11" Margin="0,0,4,0" Cursor="Hand"
                                                BorderThickness="0" Background="#2E7D32" Foreground="White">
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{StaticResource MultiValueArrayConverter}">
                                                    <Binding/>
                                                    <Binding Source="{x:Static models:EstadoProducto.Activo}"/>
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Content="Agotado"
                                                Command="{Binding DataContext.MarcarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Width="82" Height="26" FontSize="11" Margin="0,0,4,0" Cursor="Hand"
                                                BorderThickness="0" Background="#EF6C00" Foreground="White">
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{StaticResource MultiValueArrayConverter}">
                                                    <Binding/>
                                                    <Binding Source="{x:Static models:EstadoProducto.Agotado}"/>
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Content="Descontinuado"
                                                Command="{Binding DataContext.MarcarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Width="110" Height="26" FontSize="11" Cursor="Hand"
                                                BorderThickness="0" Background="#C62828" Foreground="White">
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{StaticResource MultiValueArrayConverter}">
                                                    <Binding/>
                                                    <Binding Source="{x:Static models:EstadoProducto.Descontinuado}"/>
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                    <common:PaginatorBar Grid.Row="2" DataContext="{Binding ProductosPaged}"/>
                </Grid>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
