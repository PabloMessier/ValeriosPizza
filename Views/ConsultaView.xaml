<UserControl x:Class="ValeriosPizza.Views.ConsultaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:ValeriosPizza.Views.Common"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Consulta de Registros" FontSize="26" FontWeight="Light" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Filtra y busca todos los movimientos del inventario" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Filtros rápidos de período -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="FILTRAR POR PERÍODO" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="HOY" Command="{Binding FiltrarHoyCommand}" 
                                Padding="16,10" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                        <Button Content="AYER" Command="{Binding FiltrarAyerCommand}" 
                                Padding="16,10" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"/>
                        <Button Content="ESTA SEMANA" Command="{Binding FiltrarSemanaCommand}" 
                                Padding="16,10" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"/>
                        <Button Content="ESTE MES" Command="{Binding FiltrarMesCommand}" 
                                Padding="16,10" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"/>
                        <Button Content="MES ANTERIOR" Command="{Binding FiltrarMesAnteriorCommand}" 
                                Padding="16,10" FontSize="12" Margin="0,0,20,0" Cursor="Hand"
                                BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"/>

                        <!-- Separador -->
                        <Border Width="1" Background="#E0E0E0" Margin="0,0,20,0"/>

                        <!-- Filtro por rango de fechas -->
                        <TextBlock Text="Desde:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding FechaInicio}" 
                                    FontSize="12" Width="120" Margin="0,0,15,0"/>
                        <TextBlock Text="Hasta:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding FechaFin}" 
                                    FontSize="12" Width="120" Margin="0,0,15,0"/>
                        <Button Content="BUSCAR" Command="{Binding BuscarPorFechasCommand}" 
                                Padding="20,10" FontSize="12" Cursor="Hand"
                                Background="#2196F3" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filtros por tipo y totales -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Checkboxes de tipo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,30,0">
                        <TextBlock Text="MOSTRAR:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <CheckBox Content="Entradas" IsChecked="{Binding MostrarEntradas}" 
                                  Command="{Binding AplicarFiltrosTipoCommand}" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Gastos" IsChecked="{Binding MostrarGastos}" 
                                  Command="{Binding AplicarFiltrosTipoCommand}" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Mermas" IsChecked="{Binding MostrarMermas}" 
                                  Command="{Binding AplicarFiltrosTipoCommand}" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Cortesías" IsChecked="{Binding MostrarCortesias}" 
                                  Command="{Binding AplicarFiltrosTipoCommand}" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Mercancía" IsChecked="{Binding MostrarMercancias}" 
                                  Command="{Binding AplicarFiltrosTipoCommand}" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Cajas" IsChecked="{Binding MostrarCajas}"
                                  Command="{Binding AplicarFiltrosTipoCommand}" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Discos" IsChecked="{Binding MostrarDiscos}"
                                  Command="{Binding AplicarFiltrosTipoCommand}" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Apertura" IsChecked="{Binding MostrarApertura}"
                                  Command="{Binding AplicarFiltrosTipoCommand}" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Cierre" IsChecked="{Binding MostrarCierre}"
                                  Command="{Binding AplicarFiltrosTipoCommand}" FontSize="12" Margin="0,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Totales -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="#E8F5E9" Padding="10,6" CornerRadius="4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="E:" FontSize="11" Foreground="#4CAF50" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding TotalEntradas}" FontSize="12" Foreground="#4CAF50" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#E3F2FD" Padding="10,6" CornerRadius="4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="G:" FontSize="11" Foreground="#2196F3" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding TotalGastos}" FontSize="12" Foreground="#2196F3" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFF3E0" Padding="10,6" CornerRadius="4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="M:" FontSize="11" Foreground="#FF9800" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding TotalMermas}" FontSize="12" Foreground="#FF9800" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F3E5F5" Padding="10,6" CornerRadius="4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="C:" FontSize="11" Foreground="#9C27B0" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding TotalCortesias}" FontSize="12" Foreground="#9C27B0" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#E0F7FA" Padding="10,6" CornerRadius="4" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="N:" FontSize="11" Foreground="#00BCD4" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding TotalMercancias}" FontSize="12" Foreground="#00BCD4" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AccentBrush}" Padding="12,6" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding TotalRegistros}" FontSize="12" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Período seleccionado -->
            <Border Grid.Row="3" Background="#E3F2FD" Padding="15,10" CornerRadius="4" Margin="0,0,0,15">
                <TextBlock Text="{Binding PeriodoTexto}" FontSize="14" Foreground="#1976D2" FontWeight="Medium"/>
            </Border>

            <!-- Tabla de resultados -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="RESULTADOS" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RegistrosPaged.Items}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="{DynamicResource CardBackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource CardAlternateRowBrush}"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              CanUserResizeRows="False"
                              FontSize="13"
                              RowHeight="40"
                              MinHeight="400">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#999999"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E8E8E8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#333333"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <!-- Cada columna marca su SortMemberPath explícito.
                                 Para columnas con StringFormat el sort se hace por la
                                 propiedad subyacente (no por el texto renderizado).
                                 Para DataGridTemplateColumn (TIPO) WPF necesita el
                                 SortMemberPath; sin él, hacer clic en el header no hacía nada. -->
                            <DataGridTextColumn Header="FECHA"
                                                Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}"
                                                SortMemberPath="Fecha" Width="140"/>
                            <DataGridTemplateColumn Header="TIPO" Width="100" SortMemberPath="Tipo">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ColorTipo}" Padding="8,4" CornerRadius="3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Tipo}" Foreground="White" FontWeight="Medium" FontSize="10"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="INGREDIENTE / PRODUCTO"
                                                Binding="{Binding Ingrediente}"
                                                SortMemberPath="Ingrediente" Width="*"/>
                            <DataGridTextColumn Header="CANTIDAD"
                                                Binding="{Binding Cantidad}"
                                                SortMemberPath="Cantidad" Width="140"/>
                            <DataGridTextColumn Header="DETALLES"
                                                Binding="{Binding Detalles}"
                                                SortMemberPath="Detalles" Width="220"/>
                            <!-- BODEGA: botón por fila para enviar el registro al almacén.
                                 No es ordenable porque es una acción. -->
                            <DataGridTemplateColumn Header="BODEGA" Width="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="→ Bodega"
                                                ToolTip="Agregar este registro a la pantalla Bodega"
                                                Command="{Binding DataContext.AgregarABodegaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4" FontSize="11" Cursor="Hand"
                                                BorderThickness="0" Background="#6D4C41" Foreground="White"
                                                HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <common:PaginatorBar Grid.Row="2" DataContext="{Binding RegistrosPaged}"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
