<UserControl x:Class="ValeriosPizza.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrls="clr-namespace:ValeriosPizza.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado compacto -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Dashboard" FontSize="26" FontWeight="Light" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding FechaHoy}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tarjetas destacadas: Discos y Cajas disponibles -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Background="{DynamicResource AccentBrush}" Padding="20,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="DISCOS DISPONIBLES" FontSize="13" Foreground="{DynamicResource AccentTextBrush}" Opacity="0.75" FontWeight="Medium"/>
                        <TextBlock Text="Bases de pizza listas" FontSize="13" Foreground="{DynamicResource AccentTextBrush}" Opacity="0.6" Margin="0,2,0,0"/>
                    </StackPanel>
                    <!-- Stepper + botón "Actualizar". El stepper sólo modifica
                         el valor visible; nada se escribe en la BD hasta que
                         la usuaria presiona Actualizar. El botón está
                         deshabilitado cuando no hay ajuste pendiente. -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ctrls:NumericStepper
                            Value="{Binding DiscosDisponibles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="0"
                            Width="180" Height="42"/>
                        <Button Content="Actualizar"
                                Command="{Binding ActualizarDiscosCommand}"
                                ToolTip="Guarda el ajuste como una transacción en la base de datos"
                                HorizontalAlignment="Stretch"
                                Margin="0,6,0,0" Padding="0,4"
                                FontSize="12" FontWeight="SemiBold"
                                Cursor="Hand"
                                Background="#33FFFFFF" Foreground="White"
                                BorderBrush="#55FFFFFF" BorderThickness="1"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Background="#5D4037" Padding="20,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CAJAS DISPONIBLES" FontSize="13" Foreground="#D7CCC8" FontWeight="Medium"/>
                        <TextBlock Text="Cajas para pizza (30 cm)" FontSize="13" Foreground="#BCAAA4" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ctrls:NumericStepper
                            Value="{Binding CajasDisponibles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="0"
                            Width="180" Height="42"/>
                        <Button Content="Actualizar"
                                Command="{Binding ActualizarCajasCommand}"
                                ToolTip="Guarda el ajuste como una transacción en la base de datos"
                                HorizontalAlignment="Stretch"
                                Margin="0,6,0,0" Padding="0,4"
                                FontSize="12" FontWeight="SemiBold"
                                Cursor="Hand"
                                Background="#33FFFFFF" Foreground="White"
                                BorderBrush="#55FFFFFF" BorderThickness="1"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Tarjetas de resumen - más compactas -->
        <UniformGrid Grid.Row="2" Columns="4" Rows="1" VerticalAlignment="Top" Margin="0,0,0,15">
            <!-- Tarjeta Entradas -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="15,12">
                <StackPanel>
                    <TextBlock Text="ENTRADAS" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding IngresosHoy}" FontSize="36" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Light" Margin="0,6,0,0"/>
                    <TextBlock Text="hoy" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta Gastos -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="15,12">
                <StackPanel>
                    <TextBlock Text="GASTOS" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding GastosHoy}" FontSize="36" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Light" Margin="0,6,0,0"/>
                    <TextBlock Text="hoy" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta Mermas -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="15,12">
                <StackPanel>
                    <TextBlock Text="MERMAS" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding MermasHoy}" FontSize="36" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Light" Margin="0,6,0,0"/>
                    <TextBlock Text="hoy" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta Cortesías -->
            <Border Style="{StaticResource CardStyle}" Padding="15,12">
                <StackPanel>
                    <TextBlock Text="CORTESÍAS" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding CortesiasHoy}" FontSize="36" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Light" Margin="0,6,0,0"/>
                    <TextBlock Text="hoy" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Mini-gráfico de tendencia: últimos 7 días de movimientos totales.
             Pintado con Rectangles cuyo Width sale de TendenciaDia.AnchoRelativo,
             para no añadir dependencia a una librería de gráficos. -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="ÚLTIMOS 7 DÍAS — MOVIMIENTOS"
                           FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Tendencia7Dias}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Etiqueta}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Rectangle Grid.Column="1" Height="14"
                                           HorizontalAlignment="Left"
                                           Width="{Binding AnchoRelativo}"
                                           RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource AccentBrush}">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsHoy}" Value="True">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EsHoy}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBlock Grid.Column="2" Text="{Binding Movimientos}"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Alertas de stock bajo -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="15,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ALERTAS DE STOCK BAJO" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" Margin="0,0,0,10"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding AlertasStock}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF5F5" Padding="12,8" Margin="0,0,0,5" CornerRadius="4">
                                <TextBlock FontSize="13" Foreground="#CC0000">
                                    <Run Text="⚠"/>
                                    <Run Text="{Binding Nombre}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding CantidadActual, StringFormat=N1}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding UnidadMedida}"/>
                                    <Run Text=" (Mín: "/>
                                    <Run Text="{Binding CantidadMinima, StringFormat=N1}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Text="No hay alertas de stock" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" 
                           Visibility="{Binding SinAlertas, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
