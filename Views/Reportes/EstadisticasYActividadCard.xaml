<UserControl x:Class="ValeriosPizza.Views.Reportes.EstadisticasYActividadCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="1000">
    <StackPanel>
        <!-- Estadísticas de Discos -->
        <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ESTADÍSTICAS DE DISCOS (BASES DE PIZZA)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Border Background="#E8F5E9" Padding="20,12" CornerRadius="4" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Preparados" FontSize="11" Foreground="#4CAF50"/>
                            <TextBlock Text="{Binding DiscosPreparadosPeriodo}" FontSize="24" Foreground="#4CAF50" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#E3F2FD" Padding="20,12" CornerRadius="4" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Utilizados" FontSize="11" Foreground="#2196F3"/>
                            <TextBlock Text="{Binding DiscosUtilizadosPeriodo}" FontSize="24" Foreground="#2196F3" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF3E0" Padding="20,12" CornerRadius="4" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Merma" FontSize="11" Foreground="#FF9800"/>
                            <TextBlock Text="{Binding DiscosMermaPeriodo}" FontSize="24" Foreground="#FF9800" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3E5F5" Padding="20,12" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Cortesía" FontSize="11" Foreground="#9C27B0"/>
                            <TextBlock Text="{Binding DiscosCortesiaPeriodo}" FontSize="24" Foreground="#9C27B0" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actividad Diaria -->
        <Border Style="{StaticResource CardStyle}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ACTIVIDAD DIARIA (ÚLTIMOS 14 DÍAS DEL PERÍODO)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" Margin="0,0,0,12"/>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding ResumenDiario}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Padding="8" CornerRadius="4" Background="#F5F5F5">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding FechaTexto}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Total}" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontWeight="Medium" Margin="0,4,0,4"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Entradas}" FontSize="9" Foreground="#4CAF50" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Gastos}" FontSize="9" Foreground="#2196F3" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Mermas}" FontSize="9" Foreground="#FF9800"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
