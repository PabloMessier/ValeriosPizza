<Window x:Class="ValeriosPizza.Windows.VisorFacturaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vista previa de factura"
        Width="980" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior: nombre del archivo + acciones -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="16,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Factura digital" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="NombreArchivoText" Text="—"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⤓  Descargar copia"
                            Click="Descargar_Click"
                            Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold"/>
                    <Button Content="Abrir en aplicación externa"
                            Click="AbrirExterno_Click"
                            Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                            Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="Cerrar"
                            Click="Cerrar_Click"
                            Padding="14,8" Cursor="Hand"
                            Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenedor de vista previa -->
        <Grid Grid.Row="1" Background="#202020">
            <!-- Imagen -->
            <ScrollViewer x:Name="ImagenScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <Image x:Name="VistaImagen" Stretch="Uniform" Margin="20"/>
            </ScrollViewer>

            <!-- PDF y otros documentos visibles vía WebView2 (Edge) -->
            <wv2:WebView2 x:Name="VistaWeb" Visibility="Collapsed"/>

            <!-- Mensaje de error / no soportado -->
            <TextBlock x:Name="MensajeText"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="#DDDDDD" TextWrapping="Wrap"
                       MaxWidth="520" TextAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
