<Window x:Class="ValeriosPizza.Windows.IngredienteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border Padding="22">
        <StackPanel>
            <TextBlock Text="{Binding Titulo}"
                       FontSize="20" FontWeight="Light"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>

            <TextBlock Text="Nombre" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NombreTextBox"
                     Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="Unidad de medida" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox IsEditable="True"
                      Text="{Binding UnidadMedida, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding UnidadesSugeridas}"
                      Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="Cantidad actual (stock inicial)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CantidadActualTexto, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="Cantidad mínima (alerta de stock bajo)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CantidadMinimaTexto, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8" FontSize="14" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#D32F2F" FontSize="12" Margin="0,0,0,8"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancelar" Click="CancelarClick"
                        Padding="18,9" FontSize="13" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundBrush}" Cursor="Hand"/>
                <Button Content="Guardar" Click="GuardarClick"
                        Padding="22,9" FontSize="13"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontWeight="Medium"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
